{
  "id": "openclaw-test",
  "name": "OpenClaw Browser Test",
  "agentName": "browser-agent",
  "description": "Navigate to example.com and verify the page title",
  "requiredCapabilities": ["browser"],
  "parameters": {
    "browser": {
      "action": "navigate",
      "url": "https://example.com",
      "assert": {
        "title": "Example Domain"
      },
      "screenshot": true
    }
  }
}
